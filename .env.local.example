# Copy to `.env.local` (never commit `.env.local`).
#
# TL;DR for real LLM answers in the Agent / course generation:
#   Option A (recommended): run the managed proxy — `npm run dev:full` — and put
#     OPENAI_API_KEY in `server/.env`. The key never reaches the browser.
#   Option B: set VITE_OPENAI_API_KEY below (browser talks to OpenAI directly).
#   Option C: point VITE_LLM_PROXY_URL at any OpenAI-compatible endpoint
#     (vLLM, Ollama with an OpenAI shim, OpenRouter…).
# With none of these, the Agent falls back to canned offline replies and course
# generation uses the offline heuristic engine.

# Optional direct OpenAI key — prefer the managed proxy instead.
VITE_OPENAI_API_KEY=

# Local Synapse proxy (Google OAuth, LLM, calendar, tasks, Meet).
# Started automatically by `npm run dev:full`.
VITE_LLM_PROXY_URL=http://localhost:8787/v1
